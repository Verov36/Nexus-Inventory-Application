generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN       // owner — full system control, only one who can mass-import
  ADMIN             // manages users and permissions
  MANAGER           // sets truck caps, reviews overage justifications, runs reports
  WAREHOUSE_MANAGER // oversees warehouse operations and staff
  WAREHOUSE_EMPLOYEE // receives and checks in parts
  TRUCK_TECH        // checks parts out to a truck, submits justifications
}

enum TransactionType {
  RECEIVE          // part comes into warehouse
  CHECKOUT         // part leaves warehouse or truck to a person
  RETURN           // part comes back (unused / job overage)
  TRANSFER         // moves between two locations (e.g. truck to truck)
  ADJUSTMENT        // manager correction / cycle count
  CONSUME          // installed / used on a job: leaves a truck, goes to the customer
}

// Why stock was loaded onto a truck. Loading is not using: parts only leave
// inventory when a CONSUME records them as used on a job.
enum CheckoutType {
  JOB_USE   // loaded for a specific job / work order
  RESTOCK   // general truck replenishment, no job required
}

enum LocationType {
  WAREHOUSE
  TRUCK
}

enum JustificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TruckCountStatus {
  OPEN       // being counted
  SUBMITTED  // tech finished; waiting for a manager to apply or discard
  APPLIED    // variances posted as ADJUSTMENT transactions
  DISCARDED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  // Independent of role — the warehouse manager designates up to two people
  // (besides the super admin, who always has access) allowed to receive
  // parts. Toggled in /admin/users, capped and enforced server-side.
  canReceiveParts Boolean @default(false)
  // Set when an admin deactivates the account. A deactivated user can't sign
  // in and any session they already hold stops working on its next request.
  // Accounts with history are deactivated, never deleted.
  disabledAt   DateTime?
  // Stamped into the session token at sign-in. Bumping it (password change,
  // reset, deactivation) invalidates every session issued before the bump.
  sessionVersion Int     @default(0)
  truck        Truck?   @relation("TruckTech")
  createdAt    DateTime @default(now())

  transactions       InventoryTransaction[] @relation("PerformedBy")
  justifications      OverageJustification[] @relation("SubmittedBy")
  reviewedJustifications OverageJustification[] @relation("ReviewedBy")
  startedCounts      TruckCount[] @relation("CountStartedBy")
  reviewedCounts     TruckCount[] @relation("CountReviewedBy")
  passwordResetTokens PasswordResetToken[]
}

// One-time links for "forgot password". Only the SHA-256 of the token is
// stored, so a database read can't be turned into a working link.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model Part {
  id             String   @id @default(cuid())
  sku            String   @unique
  name           String
  description    String?
  category       String?
  unitCost       Decimal? @db.Decimal(10, 2)
  barcodeValue   String   @unique // value encoded in the QR/barcode label
  reorderThreshold Int    @default(0)
  // Purchasing: who to buy it from, their part number, and how many to
  // order when it drops to the threshold (0 = let the app suggest).
  supplier           String?
  supplierPartNumber String?
  reorderQty         Int      @default(0)
  // Set when someone marks it ordered on the reorder list; cleared the next
  // time the part is received so it stops showing as "on order".
  orderedAt     DateTime?
  orderedQty    Int?
  orderedById   String?
  createdAt      DateTime @default(now())

  stockLevels    StockLevel[]
  truckLimits    TruckStockLimit[]
  transactions   InventoryTransaction[]
  countLines     TruckCountLine[]
}

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  stockLevels StockLevel[]
}

model Truck {
  id         String   @id @default(cuid())
  label      String   // e.g. "Truck 4" / license plate
  techId     String?  @unique
  tech       User?    @relation("TruckTech", fields: [techId], references: [id])
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  stockLevels StockLevel[]
  stockLimits TruckStockLimit[]
  justifications OverageJustification[]
  counts      TruckCount[]
}

// A physical count of one truck. Lines snapshot what the system expected
// when the count started; the tech fills in what they actually found. A
// manager applies the variances (posting ADJUSTMENT transactions) or
// discards the count.
model TruckCount {
  id           String           @id @default(cuid())
  truckId      String
  truck        Truck            @relation(fields: [truckId], references: [id])
  startedById  String
  startedBy    User             @relation("CountStartedBy", fields: [startedById], references: [id])
  status       TruckCountStatus @default(OPEN)
  notes        String?
  createdAt    DateTime         @default(now())
  submittedAt  DateTime?
  reviewedById String?
  reviewedBy   User?            @relation("CountReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  lines TruckCountLine[]
}

model TruckCountLine {
  id          String     @id @default(cuid())
  countId     String
  count       TruckCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  partId      String
  part        Part       @relation(fields: [partId], references: [id])
  expectedQty Int
  countedQty  Int?
  // When countedQty was last entered. Applying the count sets the truck to
  // countedQty plus whatever moved on or off it after this moment, so stock
  // that moved while the count was open isn't counted twice or lost.
  countedAt   DateTime?
  // The adjustment actually posted when the count was applied (can differ
  // from countedQty - expectedQty when stock moved during the count).
  appliedDelta Int?

  @@unique([countId, partId])
}

// Current on-hand quantity for a part at a given location (warehouse or truck)
model StockLevel {
  id          String     @id @default(cuid())
  partId      String
  part        Part       @relation(fields: [partId], references: [id])
  locationType LocationType
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])
  truckId     String?
  truck       Truck?     @relation(fields: [truckId], references: [id])
  quantity    Int        @default(0)
  updatedAt   DateTime   @updatedAt

  @@unique([partId, warehouseId, truckId])
}

// Manager-defined cap for how much of a part (or category) may sit on a given truck
model TruckStockLimit {
  id        String   @id @default(cuid())
  truckId   String
  truck     Truck    @relation(fields: [truckId], references: [id])
  partId    String?  // null + category set = category-level cap
  part      Part?    @relation(fields: [partId], references: [id])
  category  String?
  maxQty    Int
  setById   String
  createdAt DateTime @default(now())

  @@unique([truckId, partId, category])
}

model Job {
  id        String   @id @default(cuid())
  jobNumber String   @unique
  customer  String?
  status    String   @default("open")
  createdAt DateTime @default(now())

  usages PartUsage[]
}

// Every movement of parts is recorded here — the immutable audit trail
model InventoryTransaction {
  id              String           @id @default(cuid())
  type            TransactionType
  checkoutType    CheckoutType?    // set only when type = CHECKOUT
  partId          String
  part            Part             @relation(fields: [partId], references: [id])
  quantity        Int
  fromLocationType LocationType?
  fromWarehouseId String?
  fromTruckId     String?
  toLocationType  LocationType?
  toWarehouseId   String?
  toTruckId       String?
  performedById   String
  performedBy     User             @relation("PerformedBy", fields: [performedById], references: [id])
  notes           String?          // reason for a RETURN or ADJUSTMENT — why stock left the truck
  createdAt       DateTime         @default(now())

  partUsage       PartUsage?
  justification   OverageJustification?
}

// Links a JOB_USE checkout transaction to the job it was consumed on
model PartUsage {
  id            String                @id @default(cuid())
  transactionId String                @unique
  transaction   InventoryTransaction  @relation(fields: [transactionId], references: [id])
  jobId         String
  job           Job                   @relation(fields: [jobId], references: [id])
  notes         String?
}

// Required before a JOB_USE checkout is allowed to proceed when it would
// push (or keep) the truck over its manager-set stock limit
model OverageJustification {
  id            String               @id @default(cuid())
  transactionId String?              @unique
  transaction   InventoryTransaction? @relation(fields: [transactionId], references: [id])
  truckId       String
  truck         Truck                @relation(fields: [truckId], references: [id])
  submittedById String
  submittedBy   User                 @relation("SubmittedBy", fields: [submittedById], references: [id])
  explanation   String
  relatedJobNumbers String[]
  status        JustificationStatus  @default(PENDING)
  reviewedById  String?
  reviewedBy    User?                @relation("ReviewedBy", fields: [reviewedById], references: [id])
  createdAt     DateTime             @default(now())
  reviewedAt    DateTime?
}

// A single adjustable schedule for automated usage reports — frequency can be
// changed once inventory settles into a manageable rhythm.
model ReportSchedule {
  id            String   @id @default(cuid())
  frequencyDays Int      @default(7)
  lastRunAt     DateTime?
  nextRunAt     DateTime @default(now())
  updatedById   String?
  updatedAt     DateTime @updatedAt
}

// Stored result of each automated report run, so managers can browse history
// without re-querying transactions each time.
model ReportSnapshot {
  id          String   @id @default(cuid())
  rangeFrom   DateTime
  rangeTo     DateTime
  summaryJson String   @db.Text
  generatedAt DateTime @default(now())
}

// Fixed-window counters for rate limiting sign-in, password reset and setup.
// Kept in Postgres so limits hold across every app instance without adding
// Redis. Stale rows are swept opportunistically by lib/rate-limit.ts.
model RateLimit {
  key         String   @id
  windowStart DateTime
  count       Int

  @@index([windowStart])
}

// Replay protection for writes that clients may retry (the Field App's
// "parts used" calls, a scanner double-tap, a timeout followed by a retry).
// The first request with a key does the work and stores its response; any
// later request with the same key gets that stored response back and moves
// no stock.
model IdempotencyRecord {
  // Who sent it (user id or API client), so keys from different callers never collide.
  scope      String
  key        String
  status     Int
  body       Json
  createdAt  DateTime @default(now())

  @@id([scope, key])
  @@index([createdAt])
}
