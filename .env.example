# Railway-hosted Postgres connection string
DATABASE_URL="postgresql://user:password@host:5432/nexus_inventory"

# NextAuth v5
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Warehouse this browser session receives parts into (from `npm run seed` output).
# Optional: the server falls back to DEFAULT_WAREHOUSE_ID, then to the first
# warehouse in the database, so a missing value here won't break receiving.
NEXT_PUBLIC_DEFAULT_WAREHOUSE_ID=""
DEFAULT_WAREHOUSE_ID=""

# Shared secret the scheduled report cron job must send as
# Authorization: Bearer <value> — generate with openssl rand -base64 32.
# The cron endpoint refuses to run until this is set.
CRON_SECRET=""
